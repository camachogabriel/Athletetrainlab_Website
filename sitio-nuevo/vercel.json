{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/pruebas-rendimiento", "destination": "/pruebas-rendimiento.html" },
    { "source": "/plan-entrenamientos", "destination": "/plan-entrenamientos.html" },
    { "source": "/bikefit-3d", "destination": "/bikefit-3d.html" },
    { "source": "/somos-atl", "destination": "/somos-atl.html" },
    { "source": "/convenios", "destination": "/convenios.html" },
    { "source": "/contacto", "destination": "/contacto.html" },
    { "source": "/atl-principiantes", "destination": "/atl-principiantes.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
